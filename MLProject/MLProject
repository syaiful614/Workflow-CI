name: Heart_Disease_MLOps

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      n_estimators:
        type: int
        default: 200
      max_depth:
        type: int
        default: 8
      min_samples_split:
        type: int
        default: 5
      max_features:
        type: str
        default: "sqrt"
      train_path:
        type: str
        default: "heart_preprocessing/train.csv"
      test_path:
        type: str
        default: "heart_preprocessing/test.csv"
    command: >
      python modelling.py
      --n_estimators {n_estimators}
      --max_depth {max_depth}
      --min_samples_split {min_samples_split}
      --max_features {max_features}
      --train_path {train_path}
      --test_path {test_path}
